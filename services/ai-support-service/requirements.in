# Direct dependencies for ai-support-service. Versions track 02-TECH-STACK.md § 4.3.
# requirements.txt is generated from this file with pip-compile -- never edit it
# by hand (02-TECH-STACK.md § 12, rule 2).
#
# Datadog packages (ddtrace, and ddtrace.llmobs) are deliberately absent until
# Phase 8. `openai` points at mock-llm via LLM_BASE_URL and at a real provider by
# changing that one variable.
#
# No aiokafka: this service produces to and consumes from no topic (§ 6).

fastapi~=0.115.0
uvicorn[standard]~=0.30.0
pydantic~=2.9.0
pydantic-settings~=2.5.0
sqlalchemy[asyncio]~=2.0.0
asyncpg~=0.29.0
redis~=5.0.0
httpx~=0.27.0
structlog~=24.4.0
openai~=1.50.0

# Datadog APM. Pinned exactly rather than with ~=, unlike everything else
# here: ddtrace patches libraries by version, so a bump that looks like a
# patch release can silently stop instrumenting a library it used to handle,
# and the only symptom is spans that stop appearing.
ddtrace==2.14.0

# The DogStatsD client, for the business metrics in Phase 10. It ships
# separately from ddtrace and is not pulled in as a dependency.
datadog~=0.50.0
