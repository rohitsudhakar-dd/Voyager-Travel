{
  "name": "api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Voyager's public API: auth, BFF aggregation, and the admin control plane",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@fastify/rate-limit": "9.1.0",
    "bcryptjs": "2.4.3",
    "fastify": "4.28.1",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.0",
    "pino": "9.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.16.10",
    "@types/pg": "8.11.10",
    "tsx": "4.19.1",
    "typescript": "5.6.2"
  }
}
