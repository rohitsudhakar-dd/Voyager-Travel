email-validator~=2.2.0

# Datadog APM. Pinned exactly rather than with ~=, unlike everything else
# here: ddtrace patches libraries by version, so a bump that looks like a
# patch release can silently stop instrumenting a library it used to handle,
# and the only symptom is spans that stop appearing.
ddtrace==2.14.0

# The DogStatsD client, for the business metrics in Phase 10. It ships
# separately from ddtrace and is not pulled in as a dependency.
datadog~=0.50.0
