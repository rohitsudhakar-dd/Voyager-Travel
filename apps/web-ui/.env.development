# Loaded by `vite` (development mode) only. Committed on purpose: this is what
# makes `npm run dev` render every screen with no backend running.
#
# `npm run dev:live` uses .env.live instead and talks to a real api-gateway.

VITE_USE_MOCKS=true
VITE_API_BASE_URL=/api
VITE_DD_ENV=local
VITE_DD_VERSION=dev
VITE_DD_GIT_COMMIT_SHA=
