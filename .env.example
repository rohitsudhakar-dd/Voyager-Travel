# Voyager environment configuration.
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Canonical reference: 02-TECH-STACK.md § 7.1

# ---- Datadog ----
DD_API_KEY=                                  # required; nothing reaches Datadog without it
DD_APP_KEY=                                  # only needed for `make dd-apply` (dashboards-as-code)
DD_SITE=datadoghq.com                        # must match your org: datadoghq.com | datadoghq.eu | us5.datadoghq.com
DD_ENV=demo                                  # the key correlation dimension; keep it consistent
DD_VERSION=dev                               # set by infra/ec2/deploy.sh from the git SHA
DD_GIT_REPOSITORY_URL=github.com/example/voyager   # enables Source Code Integration
DD_GIT_COMMIT_SHA=                           # set by infra/ec2/deploy.sh from the git SHA
OWNER=voyager                                # feeds the `owner:` tag in DD_TAGS

# ---- Sampling / cost controls ----
DD_TRACE_SAMPLE_RATE=1.0                     # 1.0 during demos; `make idle-mode` drops it to 0.2
DD_TRACE_SAMPLING_RULES=                     # empty in demo-mode; populated by `make idle-mode` (02-TECH-STACK.md § 8)
DD_PROFILING_ENABLED=true                    # Continuous Profiler in every backend service
DD_LOGS_INJECTION=true                       # injects dd.trace_id / dd.span_id into every log line
DD_DATA_STREAMS_ENABLED=true                 # must be true on BOTH Kafka producers and consumers
RUM_SESSION_SAMPLE_RATE=100                  # percent of browser sessions captured by RUM
RUM_SESSION_REPLAY_SAMPLE_RATE=100           # the single most expensive setting; drop to 20 when idle

# ---- RUM (build-time: rebuild web-ui after changing these) ----
VITE_DD_RUM_APPLICATION_ID=                  # from your Datadog RUM application
VITE_DD_RUM_CLIENT_TOKEN=                    # from your Datadog RUM application
VITE_DD_SITE=datadoghq.com                   # must match DD_SITE or RUM data goes nowhere
VITE_DD_ENV=demo                             # must match DD_ENV for RUM -> APM correlation
VITE_API_BASE_URL=http://localhost/api       # the PUBLIC url the browser calls, not an internal hostname

# ---- Data layer ----
POSTGRES_USER=voyager                        # application role that owns the `voyager` schema
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32   # generate: openssl rand -hex 32
POSTGRES_DB=voyager                          # database name; the Agent's postgres check references it
DD_PG_PASSWORD=change-me-openssl-rand-hex-32 # password for the read-only `datadog` monitoring role
MOCK_DB_PASSWORD=change-me-openssl-rand-hex-32    # password for `voyager_readonly`, the role mock-gds reads inventory with
REDIS_URL=redis://redis:6379                 # cache, refresh-token store, and the voyager:chaos hash
KAFKA_BROKERS=kafka:9092                     # single KRaft broker, internal listener

# ---- App ----
JWT_SECRET=change-me-openssl-rand-hex-32     # signs access tokens; generate: openssl rand -hex 32
ADMIN_SECRET=change-me-openssl-rand-hex-32   # value of the X-Voyager-Admin header that gates /admin
PUBLIC_HOSTNAME=localhost                    # your domain; Caddy uses it to obtain a TLS certificate
SEED_RANDOM_SEED=20260101                    # fixed RNG seed so seeding is reproducible across demos
HOLD_TTL_MINUTES=15                          # inventory hold lifetime; only shorten it to test the sweeper

# ---- LLM ----
LLM_PROVIDER=mock                            # mock | openai
LLM_BASE_URL=http://mock-llm:4930/v1         # point at a real provider to swap the mock out
LLM_API_KEY=mock-key                         # real key required only when LLM_PROVIDER=openai
LLM_MODEL=voyager-support-v1                 # model name reported on LLM Observability spans

# ---- Load generation ----
LOADGEN_API_ENABLED=true                     # k6 API traffic
LOADGEN_API_VUS=15                           # virtual users; directly proportional to span volume
LOADGEN_BROWSER_ENABLED=true                 # Playwright traffic; required for RUM sessions
LOADGEN_BROWSER_CONCURRENCY=2                # concurrent Chromium sessions; reduce to 1 if memory is tight
