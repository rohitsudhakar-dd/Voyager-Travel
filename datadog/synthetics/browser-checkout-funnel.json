      "type": "typeText",
      "allowFailure": false,
      "isCritical": true,
      "timeout": 30,
      "params": {
        "element": {
          "userLocator": {
            "failTestOnCannotLocate": true,
            "values": [{ "type": "css", "value": "[data-testid='passenger-0-first-name']" }]
