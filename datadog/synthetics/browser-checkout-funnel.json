{
  "name": "[Voyager] Checkout funnel",
  "type": "browser",
  "status": "live",
  "locations": ["aws:eu-west-1"],
  "tags": [
    "project:voyager",
    "team:demo",
    "managed_by:voyager-datadog-config",
    "voyager_id:browser-checkout-funnel",
    "service:voyager-web",
    "env:demo"
  ],
  "config": {
    "assertions": [],
    "request": {
      "method": "GET",
      "url": "https://{{PUBLIC_HOSTNAME}}/"
    },
    "variables": []
  },
  "steps": [
    {
      "name": "Choose the flights tab",
      "type": "click",
      "allowFailure": false,
      "isCritical": true,
      "timeout": 30,
      "params": {
        "element": {
          "userLocator": {
            "failTestOnCannotLocate": true,
            "values": [{ "type": "css", "value": "[data-testid='search-tab-flights']" }]
          }
        }
      }
    },
    {
      "name": "Type the origin airport",
      "type": "typeText",
      "allowFailure": false,
      "isCritical": true,
      "timeout": 30,
      "params": {
        "element": {
          "userLocator": {
            "failTestOnCannotLocate": true,
            "values": [{ "type": "css", "value": "[data-testid='search-origin']" }]
          }
        },
        "value": "LHR",
        "delay": 50
      }
    },
    {
      "name": "Pick the first origin suggestion",
      "type": "click",
      "allowFailure": false,
      "isCritical": true,
      "timeout": 30,
      "params": {
        "element": {
          "userLocator": {
            "failTestOnCannotLocate": true,
            "values": [{ "type": "css", "value": "[data-testid='combobox-option']" }]
          }
        }
      }
    },
    {
      "name": "Type the destination airport",
      "type": "typeText",
      "allowFailure": false,
      "isCritical": true,
      "timeout": 30,
      "params": {
        "element": {
          "userLocator": {
            "failTestOnCannotLocate": true,
            "values": [{ "type": "css", "value": "[data-testid='search-destination']" }]
          }
        },
        "value": "JFK",
        "delay": 50
      }
    },
    {
      "name": "Pick the first destination suggestion",
      "type": "click",
      "allowFailure": false,
      "isCritical": true,
      "timeout": 30,
      "params": {
        "element": {
          "userLocator": {
            "failTestOnCannotLocate": true,
            "values": [{ "type": "css", "value": "[data-testid='combobox-option']" }]
          }
        }
      }
    },
    {
      "name": "Submit the flight search",
      "type": "click",
      "allowFailure": false,
      "isCritical": true,
      "timeout": 30,
      "params": {
        "element": {
          "userLocator": {
            "failTestOnCannotLocate": true,
            "values": [{ "type": "css", "value": "[data-testid='search-submit']" }]
          }
        }
      }
    },
    {
      "name": "Results are on the page",
      "type": "assertElementPresent",
      "allowFailure": false,
      "isCritical": true,
      "timeout": 60,
      "params": {
        "element": {
          "userLocator": {
            "failTestOnCannotLocate": true,
            "values": [{ "type": "css", "value": "[data-testid='flight-result-row']" }]
          }
        }
      }
    },
    {
      "name": "Select the first result",
      "type": "click",
      "allowFailure": false,
      "isCritical": true,
      "timeout": 30,
      "params": {
        "element": {
          "userLocator": {
            "failTestOnCannotLocate": true,
            "values": [{ "type": "css", "value": "[data-testid='flight-result-select']" }]
          }
        }
      }
    },
    {
      "name": "We reached the checkout review step",
      "type": "assertCurrentUrl",
      "allowFailure": false,
      "isCritical": true,
      "timeout": 60,
      "params": {
        "check": "contains",
