              "query": "env:demo status:(error OR warn)",
              "indexes": [],
              "columns": ["service", "@error.kind", "@booking.state", "@chaos.active_flags"],
              "show_date_column": true,
              "show_message_column": true,
              "message_display": "expanded-md",
