                      "name": "hits",
                      "query": "sum:trace.fastapi.request.hits{$env,$service,$route} by {service}.as_rate()"
                    }
                  ],
                  "formulas": [{ "formula": "hits" }],
                  "style": { "palette": "cool", "line_type": "solid", "line_width": "normal" }
                }
              ]
            }
          },
          {
            "definition": {
              "type": "heatmap",
              "title": "Error rate heatmap by service (%)",
              "show_legend": false,
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "errors",
                      "query": "sum:trace.fastapi.request.errors{$env,$service,$route} by {service}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "hits",
                      "query": "sum:trace.fastapi.request.hits{$env,$service,$route} by {service}.as_count()"
                    }
                  ],
                  "formulas": [{ "formula": "100 * errors / hits", "alias": "Error rate %" }],
                  "style": { "palette": "warm" }
                }
              ],
              "yaxis": { "include_zero": true }
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Latency p50 / p95 / p99 by service (ms)",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": ["avg", "max", "value"],
              "yaxis": { "include_zero": false },
              "requests": [
                {
                  "display_type": "line",
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "p50",
                      "query": "p50:trace.fastapi.request{$env,$service,$route} by {service}"
                    }
                  ],
                  "formulas": [{ "formula": "p50 * 1000", "alias": "p50" }],
                  "style": { "palette": "grey", "line_type": "dotted", "line_width": "thin" }
                },
                {
                  "display_type": "line",
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "p95",
                      "query": "p95:trace.fastapi.request{$env,$service,$route} by {service}"
                    }
                  ],
                  "formulas": [{ "formula": "p95 * 1000", "alias": "p95" }],
                  "style": { "palette": "dog_classic", "line_type": "solid", "line_width": "normal" }
                },
                {
                  "display_type": "line",
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "p99",
                      "query": "p99:trace.fastapi.request{$env,$service,$route} by {service}"
                    }
                  ],
                  "formulas": [{ "formula": "p99 * 1000", "alias": "p99" }],
                  "style": { "palette": "warm", "line_type": "dashed", "line_width": "thin" }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "RED — Go services (http.request): search, pricing",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Requests per second by service",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": ["avg", "max", "value"],
              "yaxis": { "include_zero": true },
              "requests": [
                {
                  "display_type": "area",
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "hits",
                      "query": "sum:trace.http.request.hits{$env,$service,$route} by {service}.as_rate()"
                    }
                  ],
                  "formulas": [{ "formula": "hits" }],
                  "style": { "palette": "cool", "line_type": "solid", "line_width": "normal" }
                }
              ]
            }
          },
          {
            "definition": {
              "type": "heatmap",
              "title": "Error rate heatmap by service (%)",
              "show_legend": false,
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "errors",
                      "query": "sum:trace.http.request.errors{$env,$service,$route} by {service}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "hits",
                      "query": "sum:trace.http.request.hits{$env,$service,$route} by {service}.as_count()"
                    }
                  ],
                  "formulas": [{ "formula": "100 * errors / hits", "alias": "Error rate %" }],
                  "style": { "palette": "warm" }
                }
              ],
              "yaxis": { "include_zero": true }
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Latency p50 / p95 / p99 by service (ms)",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": ["avg", "max", "value"],
              "yaxis": { "include_zero": false },
              "requests": [
                {
                  "display_type": "line",
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "p50",
                      "query": "p50:trace.http.request{$env,$service,$route} by {service}"
                    }
                  ],
                  "formulas": [{ "formula": "p50 * 1000", "alias": "p50" }],
                  "style": { "palette": "grey", "line_type": "dotted", "line_width": "thin" }
                },
                {
                  "display_type": "line",
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "p95",
                      "query": "p95:trace.http.request{$env,$service,$route} by {service}"
                    }
                  ],
                  "formulas": [{ "formula": "p95 * 1000", "alias": "p95" }],
                  "style": { "palette": "dog_classic", "line_type": "solid", "line_width": "normal" }
                },
                {
                  "display_type": "line",
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "p99",
                      "query": "p99:trace.http.request{$env,$service,$route} by {service}"
                    }
                  ],
                  "formulas": [{ "formula": "p99 * 1000", "alias": "p99" }],
                  "style": { "palette": "warm", "line_type": "dashed", "line_width": "thin" }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Upstream dependencies",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "GDS provider latency p95 by provider (ms)",
              "description": "Scenario S1 sets `gds_provider_down=TRVP`, so one series here goes flat or vanishes while the others stay healthy. That asymmetry is the whole point: the slowness is upstream, not ours.",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": ["avg", "max", "value"],
              "yaxis": { "include_zero": false },
              "requests": [
                {
                  "display_type": "line",
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "provider_p95",
                      "query": "p95:voyager.search.provider_latency{$env} by {provider}"
                    }
                  ],
                  "formulas": [{ "formula": "provider_p95" }],
                  "style": { "palette": "dog_classic", "line_type": "solid", "line_width": "normal" }
                }
              ]
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "GDS provider errors by provider and kind",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "provider_errors",
                      "query": "sum:voyager.search.provider_errors{$env} by {provider,error_kind}",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [{ "formula": "provider_errors", "limit": { "count": 10, "order": "desc" } }]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Searches returning partial results per second",
              "description": "Partial results are a correct, degraded answer rather than an error, so they never show up in the error-rate widgets above. This is the only place the degradation is visible.",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": ["avg", "max", "value"],
              "yaxis": { "include_zero": true },
              "requests": [
                {
                  "display_type": "bars",
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "partial",
                      "query": "sum:voyager.search.partial_results{$env}.as_rate()"
                    }
                  ],
                  "formulas": [{ "formula": "partial" }],
                  "style": { "palette": "warm", "line_type": "solid", "line_width": "normal" }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Containers",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Container memory RSS by container",
              "description": "Scenario S7 sets `booking_memory_leak=true`; the booking container's line climbs steadily over about twenty minutes and then drops vertically when the kernel OOM-kills it. The drop, not the climb, is what people notice first.",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": ["avg", "max", "value"],
              "yaxis": { "include_zero": true },
              "requests": [
                {
                  "display_type": "line",
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "rss",
                      "query": "avg:container.memory.rss{$env} by {container_name}"
                    }
                  ],
                  "formulas": [{ "formula": "rss" }],
                  "style": { "palette": "dog_classic", "line_type": "solid", "line_width": "normal" }
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Container CPU usage by container",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": ["avg", "max", "value"],
              "yaxis": { "include_zero": true },
              "requests": [
                {
                  "display_type": "line",
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "cpu",
                      "query": "avg:container.cpu.usage{$env} by {container_name}"
                    }
                  ],
                  "formulas": [{ "formula": "cpu" }],
                  "style": { "palette": "cool", "line_type": "solid", "line_width": "normal" }
                }
              ]
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "OOM events by container",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "oom",
                      "query": "sum:container.memory.oom_events{$env} by {container_name}",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [{ "formula": "oom", "limit": { "count": 10, "order": "desc" } }]
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
